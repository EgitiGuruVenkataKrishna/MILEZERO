# Local server
NODE_ENV=development
PORT=4173
PUBLIC_APP_URL=http://localhost:4173

# Gemini: use a key from Google AI Studio. Never put it in public/ or in browser code.
GEMINI_API_KEY=
# Check current model availability and the quota for your project before deploying.
GEMINI_MODEL=gemini-3.8-flash
MAX_AI_CONCURRENT=2
AI_CALLS_PER_IP_PER_HOUR=12

# Production subscriber database (Supabase). Use a server-side Secret key, never a publishable key here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Double opt-in email delivery (Resend). Verify your sender domain before launch.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MILEZERO <updates@example.com>

# Anti-bot protection (Cloudflare Turnstile). Configure both keys for production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set true only when the app is reachable exclusively through a trusted reverse proxy.
# The proxy must overwrite X-Forwarded-For / CF-Connecting-IP headers.
TRUST_PROXY=false
